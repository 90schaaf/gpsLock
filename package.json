{
  "name": "lockation",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "GPS based Chaster extension (beta)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @lockation/core && npm run build -w @lockation/web && npm run docs:build && node scripts/assemble-pages.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @lockation/web",
    "dev:worker": "npm run dev -w @lockation/worker",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
